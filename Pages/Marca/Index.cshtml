@page
@model Concessionaria.Pages.Marca.IndexModel
@{
    ViewData["Title"] = "Marcas";
    ViewData["TopbarTitle"] = "Marcas";
    ViewData["TopbarSubtitle"] = "Gerencie as marcas cadastradas";
    Layout = "_LayoutAdmin";

    var marcas = Model.Marcas ?? new List<Domain.Marca>();
    var totalMarcas = marcas.Count();
}

<style>
    :root {
        --brand-primary: #9f0a10;
        --brand-dark: #222222;
        --brand-border: #ececec;
        --brand-muted: #6c757d;
        --brand-soft: rgba(159, 10, 16, 0.08);
        --brand-soft-dark: rgba(34, 34, 34, 0.04);
        --brand-success: #198754;
        --brand-danger: #dc3545;
        --brand-danger-soft: rgba(220, 53, 69, 0.08);
    }

    .brand-page {
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.25rem;
    }

    .page-title {
        font-size: 1.4rem;
        font-weight: 700;
        color: var(--brand-dark);
        margin: 0;
    }

    .page-subtitle {
        font-size: .92rem;
        color: var(--brand-muted);
        margin: .2rem 0 0 0;
    }

    .search-card {
        background: #fff;
        border: 1px solid var(--brand-border);
        border-radius: 1rem;
        box-shadow: 0 8px 24px rgba(0,0,0,.05);
        margin-bottom: 1.25rem;
    }

        .search-card .card-body {
            padding: 1.1rem;
        }

    .filter-label {
        font-size: .82rem;
        font-weight: 700;
        color: var(--brand-dark);
        margin-bottom: .45rem;
    }

    .form-control,
    .form-select {
        border-radius: .85rem;
        border: 1px solid #e6e6e6;
        min-height: 46px;
        box-shadow: none !important;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: rgba(159, 10, 16, .35);
            box-shadow: 0 0 0 .2rem rgba(159, 10, 16, .08) !important;
        }

    .input-icon-wrap {
        position: relative;
    }

        .input-icon-wrap i {
            position: absolute;
            left: 1rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--brand-muted);
            font-size: 1rem;
        }

        .input-icon-wrap .form-control {
            padding-left: 2.7rem;
        }

    .btn-brand {
        background: var(--brand-primary);
        border-color: var(--brand-primary);
        color: #fff;
        border-radius: .85rem;
        font-weight: 600;
        min-height: 46px;
        display: flex;
        justify-content: center;
        align-items: center;
    }

        .btn-brand:hover {
            background: #86080d;
            border-color: #86080d;
            color: #fff;
        }

    .btn-soft-dark {
        background: #fff;
        border: 1px solid var(--brand-border);
        color: var(--brand-dark);
        border-radius: .85rem;
        font-weight: 600;
        min-height: 46px;
    }

        .btn-soft-dark:hover {
            background: #f8f8f8;
            color: var(--brand-dark);
        }

    .search-actions-row {
        display: flex;
        justify-content: flex-end;
    }

    .search-actions {
        display: flex;
        justify-content: flex-end;
        gap: .75rem;
        width: 100%;
    }

        .search-actions .btn {
            min-width: 140px;
        }

    .results-topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .results-title {
        font-size: 1rem;
        font-weight: 700;
        color: var(--brand-dark);
        margin: 0;
    }

    .results-counter {
        font-size: .92rem;
        color: var(--brand-muted);
    }

    .list-card {
        background: #fff;
        border: 1px solid var(--brand-border);
        border-radius: 1rem;
        box-shadow: 0 8px 24px rgba(0,0,0,.05);
        overflow: hidden;
    }

    .brand-table {
        margin: 0;
        vertical-align: middle;
    }

    .brand-table thead th {
        background: #f8f8f8;
        color: var(--brand-dark);
        font-size: .76rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .04em;
        border-bottom: 1px solid var(--brand-border);
        padding: 1rem .9rem;
        white-space: nowrap;
    }

    .brand-table tbody td {
        padding: 1rem .9rem;
        border-color: #f1f1f1;
        color: var(--brand-dark);
    }

    .brand-title-cell {
        display: flex;
        align-items: center;
        gap: .8rem;
        min-width: 220px;
    }

    .brand-avatar {
        width: 42px;
        height: 42px;
        border-radius: .75rem;
        background: #f8f8f8;
        border: 1px solid #ececec;
        overflow: hidden;
        flex-shrink: 0;
    }

    .brand-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .brand-title-main {
        font-size: .95rem;
        font-weight: 700;
        line-height: 1.3;
    }

    .brand-title-sub {
        font-size: .8rem;
        color: var(--brand-muted);
        line-height: 1.25;
    }

    .brand-muted {
        color: var(--brand-muted);
        font-size: .88rem;
    }

    .brand-badge-active,
    .brand-badge-inactive {
        font-size: .75rem;
        font-weight: 700;
        padding: .4rem .7rem;
        border-radius: 999px;
        white-space: nowrap;
    }

    .brand-badge-active {
        background: rgba(25, 135, 84, .10);
        color: var(--brand-success);
    }

    .brand-badge-inactive {
        background: var(--brand-danger-soft);
        color: var(--brand-danger);
    }

    .table-row-actions {
        display: flex;
        justify-content: flex-end;
        gap: .6rem;
        flex-wrap: wrap;
    }

    .table-action {
        width: 42px;
        height: 42px;
        min-width: 42px;
        padding: 0;
    }

    .empty-state {
        border: 1px dashed #dadada;
        border-radius: 1rem;
        padding: 2.5rem 1.5rem;
        text-align: center;
        background: #fff;
    }

    .empty-state-icon {
        width: 72px;
        height: 72px;
        border-radius: 22px;
        margin: 0 auto 1rem auto;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--brand-soft);
        color: var(--brand-primary);
        font-size: 1.8rem;
    }

    @@media (max-width: 768px) {
        .page-header,
        .results-topbar,
        .search-actions {
            flex-direction: column;
            align-items: stretch;
        }

        .search-actions .btn {
            min-width: 100%;
        }

        .table-row-actions {
            flex-direction: column;
            align-items: stretch;
        }

        .table-row-actions .btn {
            width: auto;
        }
    }
</style>

<div class="container-fluid brand-page">

    <div class="page-header">
        <div>
            <h1 class="page-title">
                <i class="bi bi-tags me-2"></i>
                Marcas
            </h1>
            <p class="page-subtitle">Lista e gerenciamento das marcas cadastradas</p>
        </div>

        <a href="/Marca/Upsert" class="btn btn-brand px-3">
            <i class="bi bi-plus-circle me-2"></i>
            Nova marca
        </a>
    </div>

    <div class="search-card card">
        <div class="card-body">
            <form method="get">
                <div class="row g-3">
                    <div class="col-12 col-lg-5">
                        <label class="filter-label">Pesquisar marca</label>
                        <div class="input-icon-wrap">
                            <i class="bi bi-search"></i>
                            <input type="text"
                                   name="Filtro"
                                   value="@Model.Filtro"
                                   class="form-control"
                                   placeholder="Digite o nome da marca..." />
                        </div>
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="filter-label">Ordenação</label>
                        <select name="Ordem" class="form-select">
                            <option value="" selected="@(string.IsNullOrWhiteSpace(Model.Ordem))">Nome (A-Z)</option>
                            <option value="nome_desc" selected="@(Model.Ordem == "nome_desc")">Nome (Z-A)</option>
                            <option value="recentes" selected="@(Model.Ordem == "recentes")">Mais recentes</option>
                            <option value="antigas" selected="@(Model.Ordem == "antigas")">Mais antigas</option>
                        </select>
                    </div>

                    <div class="col-12 col-md-6 col-lg-2">
                        <label class="filter-label">Status</label>
                        <select name="SomenteAtivas" class="form-select">
                            <option value="">Todas</option>
                            <option value="true" selected="@(Model.SomenteAtivas == true)">Somente ativas</option>
                            <option value="false" selected="@(Model.SomenteAtivas == false)">Somente inativas</option>
                        </select>
                    </div>

                    <div class="col-12">
                        <div class="search-actions-row">
                            <div class="search-actions">
                                <button type="submit" class="btn btn-brand">
                                    <i class="bi bi-search me-2"></i>
                                    Buscar
                                </button>

                                <a asp-page="./Index" class="btn btn-soft-dark">
                                    <i class="bi bi-arrow-counterclockwise me-2"></i>
                                    Limpar
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="results-topbar">
        <h5 class="results-title">Marcas cadastradas</h5>
        <div class="results-counter">
            <strong>@totalMarcas</strong> registro(s)
        </div>
    </div>

    @if (marcas.Any())
    {
        <div class="list-card">
            <div class="table-responsive">
                <table class="table brand-table admin-responsive-table">
                    <thead>
                        <tr>
                            <th>Marca</th>
                            <th>Status</th>
                            <th>Logo</th>
                            <th>Cadastro</th>
                            <th class="text-end">Ação</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var marca in marcas)
                        {
                            var logoUrl = string.IsNullOrWhiteSpace(marca.LogoUrl) ? "/background.png" : marca.LogoUrl;
                            <tr>
                                <td data-label="Marca">
                                    <div class="brand-title-cell">
                                        <div class="brand-avatar">
                                            <img src="@logoUrl" alt="Logo da marca @marca.Nome" />
                                        </div>
                                        <div>
                                            <div class="brand-title-main">@marca.Nome</div>
                                            <div class="brand-title-sub">ID #@marca.Id</div>
                                        </div>
                                    </div>
                                </td>
                                <td data-label="Status">
                                    @if (marca.Ativo)
                                    {
                                        <span class="brand-badge-active">Ativa</span>
                                    }
                                    else
                                    {
                                        <span class="brand-badge-inactive">Inativa</span>
                                    }
                                </td>
                                <td data-label="Logo">
                                    <span class="brand-muted text-break">@logoUrl</span>
                                </td>
                                <td data-label="Cadastro">
                                    <span class="brand-muted">
                                        @(marca.DataCadastro != default
                                            ? marca.DataCadastro.ToString("dd/MM/yyyy HH:mm")
                                            : "Não informado")
                                    </span>
                                </td>
                                <td class="text-end" data-label="Ação">
                                    <div class="table-row-actions">
                                        <a asp-page="./Upsert" asp-route-id="@marca.Id" class="btn btn-brand table-action">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-state-icon">
                <i class="bi bi-tags"></i>
            </div>

            <h5 class="fw-bold mb-2">Nenhuma marca encontrada</h5>
            <p class="text-muted mb-4">
                Não encontramos registros com os filtros informados.
            </p>

            <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
                <a asp-page="./Index" class="btn btn-soft-dark">
                    <i class="bi bi-arrow-counterclockwise me-2"></i>
                    Limpar filtros
                </a>

                <a asp-page="/Marca/Upsert" class="btn btn-brand">
                    <i class="bi bi-plus-circle me-2"></i>
                    Cadastrar marca
                </a>
            </div>
        </div>
    }
</div>
