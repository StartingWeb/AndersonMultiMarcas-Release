ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

ConnectionStrings__DefaultConnectionProd=

Storage__Provider=R2
Storage__DualReadEnabled=true
Storage__R2__AccountId=
Storage__R2__AccessKeyId=
Storage__R2__SecretAccessKey=
Storage__R2__BucketName=
Storage__R2__PublicBaseUrl=
Storage__R2__ServiceUrl=
Storage__R2__Region=auto

Seo__BaseUrl=

DataProtection__ApplicationName=AndersonMultiMarcas
DataProtection__KeysPath=/home/app/.aspnet/DataProtection-Keys

LegacyImageImport__RecoverPendingJobsOnStartup=false

Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning
